{
  "name": "coloropoly",
  "description": "Color toolbox: picker, palette, paintbox, image analyser, color sets.",
  "version": "3.11.2",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "build": "vite build",
    "changelog": "cog changelog",
    "check": "biome check . && bun run typecheck && bun run test:coverage && bun run build",
    "clean": "rm -rf coverage dist node_modules",
    "dev": "vite",
    "fix": "biome check --write .",
    "postinstall": "lefthook install",
    "preview": "vite preview",
    "release": "cog bump --auto",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "svelte-check --tsconfig ./tsconfig.app.json && bun --check",
    "update": "bun update --latest"
  },
  "dependencies": {
    "@colordx/core": "^7.3.0",
    "@lucide/svelte": "^1.77.0",
    "color-name-list": "^14.86.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tsconfig/svelte": "^5.0.9",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "jsdom": "^31.0.1",
    "lefthook": "^2.2.2",
    "svelte": "^5.59.1",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "typescript": "6.0.3"
  }
}
